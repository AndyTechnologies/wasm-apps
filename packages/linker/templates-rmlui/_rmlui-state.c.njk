// ── RmlUI bridge shared state ─────────────────────────────────────────────
// File-scope statics accessible to both native render loop functions and
// WASM host function lambdas.

// Display / Render
static SDL_Window* _rmluiWindow = nullptr;
static SDL_GLContext _rmluiGlContext = nullptr;
static RmlGL3_RenderInterface_GL3* _rmluiRenderInterface = nullptr;
static RmlSDL_SystemInterface_SDL* _rmluiSystemInterface = nullptr;

// RmlUI context registry
static std::unordered_map<Rml_ContextId, Rml::Context*> _rmluiContexts;
static Rml_ContextId _rmluiNextContextId = 1;

// Element ID → Rml::Element* map
static std::unordered_map<Rml_ElementId, Rml::Element*> _rmluiElements;
static Rml_ElementId _rmluiNextElementId = 1;

// Callback registry
static std::unordered_map<Rml_CallbackId, std::function<void()>> _rmluiCallbacks;
static Rml_CallbackId _rmluiNextCallbackId = 1;

// Single-slot string buffers for attribute / content / style getters
static char _rmluiAttrBuf[4096];
static char _rmluiContentBuf[4096];
static char _rmluiHTMLBuf[4096];
static char _rmluiStyleBuf[4096];

// Loop control
static bool _rmluiRunning = true;

// ── WASM string writer (UCS‑2 / AssemblyScript convention) ────────────────
// Allocates WASM memory via __new, writes a UCS‑2 length-prefixed string,
// returns the pointer.
static int32_t _writeString(Caller& caller, const std::string& str, int32_t extraBytes = 0) {
  if (str.empty() && extraBytes == 0) return 0;
  auto _mem = caller.get_export("memory");
  if (!_mem) return 0;
  auto* _memory = std::get_if<wasmtime::Memory>(&*_mem);
  if (!_memory) return 0;
  auto _ctx2 = caller.context();
  auto _span = _memory->data(_ctx2);
  auto* _data = _span.data();
  auto _sz = _span.size();

  // Count UCS‑2 code units needed
  int32_t ucsLen = 0;
  for (size_t _i = 0; _i < str.length(); ) {
    unsigned char _c = (unsigned char)str[_i];
    if (_c < 0x80)               { ucsLen++; _i++; }
    else if (_c < 0xE0)          { ucsLen++; _i += 2; }
    else if (_c < 0xF0)          { ucsLen++; _i += 3; }
    else                         { ucsLen += 2; _i += 4; }
  }
  int32_t allocSz = 4 + ucsLen * 2 + (extraBytes > 0 ? extraBytes : 0);

  auto _new_fn = caller.get_export("__new");
  if (!_new_fn) return 0;
  auto* _new = std::get_if<wasmtime::Func>(&*_new_fn);
  if (!_new) return 0;

  auto _ptr_result = _new->call(_ctx2, {Val(int32_t(allocSz)), Val(int32_t(0))});
  if (!_ptr_result) return 0;
  int32_t _ptr = (*_ptr_result)[0].i32();
  if (_ptr <= 0 || _ptr + allocSz > (int32_t)_sz) return 0;

  // Write length prefix
  *reinterpret_cast<int32_t*>(_data + _ptr) = ucsLen;

  // Write UCS‑2 data
  uint16_t* _dest = reinterpret_cast<uint16_t*>(_data + _ptr + 4);
  size_t _di = 0;
  for (size_t _i = 0; _i < str.length(); ) {
    unsigned char _c = (unsigned char)str[_i];
    if (_c < 0x80) {
      _dest[_di++] = (uint16_t)_c; _i++;
    } else if (_c < 0xE0) {
      _dest[_di++] = (uint16_t)(((_c & 0x1F) << 6) | ((unsigned char)str[_i+1] & 0x3F));
      _i += 2;
    } else if (_c < 0xF0) {
      _dest[_di++] = (uint16_t)(((_c & 0x0F) << 12) | (((unsigned char)str[_i+1] & 0x3F) << 6) | ((unsigned char)str[_i+2] & 0x3F));
      _i += 3;
    } else {
      uint32_t _cp = ((_c & 0x07) << 18) | (((unsigned char)str[_i+1] & 0x3F) << 12) | (((unsigned char)str[_i+2] & 0x3F) << 6) | ((unsigned char)str[_i+3] & 0x3F);
      _cp -= 0x10000;
      _dest[_di++] = (uint16_t)(0xD800 | (_cp >> 10));
      _dest[_di++] = (uint16_t)(0xDC00 | (_cp & 0x3FF));
      _i += 4;
    }
  }
  return _ptr;
}

// ── C ABI implementations ─────────────────────────────────────────────────
// These are called by WASM host function wrappers AND directly by native
// C++ code (e.g. the C++ RAII wrappers).

// ── Context lifecycle ────────────────────────────────────────────────────
extern "C" Rml_ContextId Rml_CreateContext(const char* name, int w, int h) {
  if (!name) return 0;
  Rml::Context* ctx = Rml::CreateContext(name, Rml::Vector2i(w, h));
  if (!ctx) return 0;
  Rml_ContextId id = _rmluiNextContextId++;
  _rmluiContexts[id] = ctx;
  return id;
}

extern "C" void Rml_ReleaseContext(Rml_ContextId ctx) {
  auto it = _rmluiContexts.find(ctx);
  if (it != _rmluiContexts.end()) {
    Rml::RemoveContext(it->second->GetName());
    _rmluiContexts.erase(it);
  }
}

// ── Document loading ──────────────────────────────────────────────────────
extern "C" Rml_DocumentId Rml_LoadDocument(Rml_ContextId ctx, const char* path) {
  if (!path) return 0;
  auto it = _rmluiContexts.find(ctx);
  if (it == _rmluiContexts.end()) return 0;
  Rml::ElementDocument* doc = it->second->LoadDocument(path);
  if (!doc) return 0;
  Rml_ElementId id = _rmluiNextElementId++;
  _rmluiElements[id] = doc;
  return id;
}

extern "C" Rml_DocumentId Rml_LoadDocumentFromString(Rml_ContextId ctx, const char* rml) {
  if (!rml) return 0;
  auto it = _rmluiContexts.find(ctx);
  if (it == _rmluiContexts.end()) return 0;
  Rml::ElementDocument* doc = it->second->LoadDocumentFromString(rml);
  if (!doc) return 0;
  Rml_ElementId id = _rmluiNextElementId++;
  _rmluiElements[id] = doc;
  return id;
}

extern "C" void Rml_ShowDocument(Rml_DocumentId doc) {
  auto it = _rmluiElements.find(doc);
  if (it != _rmluiElements.end()) {
    Rml::ElementDocument* d = dynamic_cast<Rml::ElementDocument*>(it->second);
    if (d) d->Show();
  }
}

extern "C" void Rml_HideDocument(Rml_DocumentId doc) {
  auto it = _rmluiElements.find(doc);
  if (it != _rmluiElements.end()) {
    Rml::ElementDocument* d = dynamic_cast<Rml::ElementDocument*>(it->second);
    if (d) d->Hide();
  }
}

extern "C" void Rml_CloseDocument(Rml_DocumentId doc) {
  auto it = _rmluiElements.find(doc);
  if (it != _rmluiElements.end()) {
    Rml::ElementDocument* d = dynamic_cast<Rml::ElementDocument*>(it->second);
    if (d) d->Close();
    _rmluiElements.erase(it);
  }
}

// ── Element tree construction ─────────────────────────────────────────────
extern "C" Rml_ElementId Rml_CreateElement(const char* tag) {
  if (!tag) return 0;
  Rml::ElementPtr el = Rml::Factory::InstanceElement(nullptr, tag, tag, Rml::XMLAttributes());
  if (!el) return 0;
  Rml_ElementId id = _rmluiNextElementId++;
  _rmluiElements[id] = el.release(); // transfer ownership
  return id;
}

extern "C" Rml_ElementId Rml_CreateTextNode(const char* text) {
  if (!text) return 0;
  Rml::ElementPtr el = Rml::Factory::InstanceTextElement(nullptr, text);
  if (!el) return 0;
  Rml_ElementId id = _rmluiNextElementId++;
  _rmluiElements[id] = el.release();
  return id;
}

extern "C" int32_t Rml_AppendChild(Rml_ElementId parent, Rml_ElementId child) {
  auto pit = _rmluiElements.find(parent);
  auto cit = _rmluiElements.find(child);
  if (pit == _rmluiElements.end() || cit == _rmluiElements.end())
    return RMLUI_ERR_INVALID_HANDLE;
  pit->second->AppendChild(cit->second);
  _rmluiElements.erase(child); // child is now owned by parent
  return RMLUI_OK;
}

extern "C" int32_t Rml_RemoveChild(Rml_ElementId parent, Rml_ElementId child) {
  auto pit = _rmluiElements.find(parent);
  auto cit = _rmluiElements.find(child);
  if (pit == _rmluiElements.end() || cit == _rmluiElements.end())
    return RMLUI_ERR_INVALID_HANDLE;
  pit->second->RemoveChild(cit->second);
  return RMLUI_OK;
}

extern "C" int32_t Rml_InsertBefore(Rml_ElementId parent, Rml_ElementId child, Rml_ElementId ref) {
  auto pit = _rmluiElements.find(parent);
  auto cit = _rmluiElements.find(child);
  auto rit = _rmluiElements.find(ref);
  if (pit == _rmluiElements.end() || cit == _rmluiElements.end() || rit == _rmluiElements.end())
    return RMLUI_ERR_INVALID_HANDLE;
  pit->second->InsertBefore(cit->second, rit->second);
  _rmluiElements.erase(child);
  return RMLUI_OK;
}

extern "C" int32_t Rml_ReplaceChild(Rml_ElementId parent, Rml_ElementId newChild, Rml_ElementId oldChild) {
  auto pit = _rmluiElements.find(parent);
  auto nit = _rmluiElements.find(newChild);
  auto oit = _rmluiElements.find(oldChild);
  if (pit == _rmluiElements.end() || nit == _rmluiElements.end() || oit == _rmluiElements.end())
    return RMLUI_ERR_INVALID_HANDLE;
  pit->second->ReplaceChild(nit->second, oit->second);
  _rmluiElements.erase(newChild);
  _rmluiElements.erase(oldChild);
  return RMLUI_OK;
}

// ── Attributes and content ────────────────────────────────────────────────
extern "C" int32_t Rml_SetAttribute(Rml_ElementId el, const char* name, const char* value) {
  if (!name || !value) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return RMLUI_ERR_INVALID_HANDLE;
  it->second->SetAttribute(name, Rml::String(value));
  return RMLUI_OK;
}

extern "C" const char* Rml_GetAttribute(Rml_ElementId el, const char* name) {
  if (!name) return nullptr;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return nullptr;
  const Rml::String* val = it->second->GetAttribute<Rml::String>(name);
  if (!val) return nullptr;
  strncpy(_rmluiAttrBuf, val->c_str(), sizeof(_rmluiAttrBuf) - 1);
  _rmluiAttrBuf[sizeof(_rmluiAttrBuf) - 1] = '\0';
  return _rmluiAttrBuf;
}

extern "C" int32_t Rml_RemoveAttribute(Rml_ElementId el, const char* name) {
  if (!name) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return RMLUI_ERR_INVALID_HANDLE;
  it->second->RemoveAttribute(name);
  return RMLUI_OK;
}

extern "C" int32_t Rml_HasAttribute(Rml_ElementId el, const char* name) {
  if (!name) return 0;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return 0;
  return it->second->HasAttribute(name) ? 1 : 0;
}

extern "C" int32_t Rml_SetTextContent(Rml_ElementId el, const char* text) {
  if (!text) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return RMLUI_ERR_INVALID_HANDLE;
  it->second->SetTextContent(text);
  return RMLUI_OK;
}

extern "C" const char* Rml_GetTextContent(Rml_ElementId el) {
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return nullptr;
  const Rml::String& val = it->second->GetTextContent();
  strncpy(_rmluiContentBuf, val.c_str(), sizeof(_rmluiContentBuf) - 1);
  _rmluiContentBuf[sizeof(_rmluiContentBuf) - 1] = '\0';
  return _rmluiContentBuf;
}

extern "C" int32_t Rml_SetInnerHTML(Rml_ElementId el, const char* html) {
  if (!html) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return RMLUI_ERR_INVALID_HANDLE;
  it->second->SetInnerHTML(html);
  return RMLUI_OK;
}

extern "C" const char* Rml_GetInnerHTML(Rml_ElementId el) {
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return nullptr;
  Rml::String val = Rml::ElementUtilities::GetInnerHTML(it->second);
  strncpy(_rmluiHTMLBuf, val.c_str(), sizeof(_rmluiHTMLBuf) - 1);
