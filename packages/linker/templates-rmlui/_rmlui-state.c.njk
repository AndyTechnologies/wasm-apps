}

extern "C" int32_t Rml_SetClassNames(Rml_ElementId el, const char* names) {
  if (!names) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return RMLUI_ERR_INVALID_HANDLE;
