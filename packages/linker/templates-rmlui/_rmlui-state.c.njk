// ── Font loading ──────────────────────────────────────────────────────────
extern "C" int32_t Rml_LoadFont(const char* path) {
  if (!path) return RMLUI_ERR_NULL_PARAM;
  return Rml::LoadFontFace(path) ? RMLUI_OK : RMLUI_ERR_INTERNAL;
}

extern "C" int32_t Rml_LoadFontFromBuffer(const char* name, const void* data, int32_t len) {
  if (!name || !data) return RMLUI_ERR_NULL_PARAM;
  Rml::byte* buf = new Rml::byte[len];
  std::memcpy(buf, data, len);
  bool ok = Rml::LoadFontFace(Rml::Span<const Rml::byte>(buf, len), name, false, Rml::FontStyle::Normal, Rml::FontWeight::Auto, buf);
  if (!ok) { delete[] buf; return RMLUI_ERR_INTERNAL; }
  return RMLUI_OK;
}

// ── Texture loading ───────────────────────────────────────────────────────
extern "C" int32_t Rml_LoadTexture(const char* path) {
  if (!path) return RMLUI_ERR_NULL_PARAM;
  // RmlUI's render interface handles texture loading from file paths
  // when textures are referenced in RCSS. This function is a no-op
  // because RmlUI loads textures automatically through the render
  // interface when a decorator or background-image references a path.
  //
  // For explicit programmatic texture generation, use
  // Rml_LoadTextureFromBuffer instead.
  return RMLUI_OK;
}

extern "C" int32_t Rml_LoadTextureFromBuffer(const char* name, const void* data, int32_t len) {
  if (!name || !data) return RMLUI_ERR_NULL_PARAM;
  // For v1, this is a placeholder returning unsupported.
  // RmlUI handles textures through its render interface automatically
  // when referenced from RCSS decorators/background-image.
  //
  // Future: Use Rml::Core::GetRenderInterface()->LoadTexture()
  // or generate a raw OpenGL texture and register it with RmlUI.
  (void)len;
  return RMLUI_ERR_UNSUPPORTED;
}

extern "C" int32_t Rml_GetTextureDimensions(const char* name, int32_t* w, int32_t* h) {
  (void)name;
  if (!w || !h) return RMLUI_ERR_NULL_PARAM;
  // In RmlUI, texture dimensions are managed internally by the render interface.
  // For v1, return unsupported — textures should be loaded through RCSS.
  // Future: Query the RmlUI render interface's texture cache.
  *w = 0;
  *h = 0;
  return RMLUI_ERR_UNSUPPORTED;
}

// ── Render loop functions (called natively from main loop) ─────────────────
extern "C" void RmlUI_ProcessSdlEvents(void) {
  SDL_Event event;
  while (SDL_PollEvent(&event)) {
    if (event.type == SDL_EVENT_QUIT) { _rmluiRunning = false; break; }
    Rml::Context* ctx = _rmluiContexts.empty() ? nullptr : _rmluiContexts.begin()->second;
    if (!ctx) continue;
    switch (event.type) {
      case SDL_EVENT_MOUSE_MOTION:
        ctx->ProcessMouseMove((int)event.motion.x, (int)event.motion.y, 0);
        break;
      case SDL_EVENT_MOUSE_BUTTON_DOWN:
        ctx->ProcessMouseButtonDown((int)event.button.button, 0);
        break;
      case SDL_EVENT_MOUSE_BUTTON_UP:
        ctx->ProcessMouseButtonUp((int)event.button.button, 0);
        break;
      case SDL_EVENT_MOUSE_WHEEL:
        ctx->ProcessMouseWheel(Rml::Vector2f((float)event.wheel.x, (float)event.wheel.y), 0);
        break;
      case SDL_EVENT_KEY_DOWN:
        ctx->ProcessKeyDown(RmlSDL::ConvertKey(event.key.keysym.sym), 0);
        break;
      case SDL_EVENT_KEY_UP:
        ctx->ProcessKeyUp(RmlSDL::ConvertKey(event.key.keysym.sym), 0);
        break;
      case SDL_EVENT_TEXT_INPUT:
        ctx->ProcessTextInput(Rml::String(event.text.text));
        break;
      case SDL_EVENT_WINDOW_RESIZED:
        ctx->SetDimensions(Rml::Vector2i((int)event.window.data1, (int)event.window.data2));
        break;
      default: break;
    }
  }
}

extern "C" void RmlUI_Update(void) {
  for (auto& kv : _rmluiContexts) {
    kv.second->Update();
  }
}

extern "C" void RmlUI_Render(void) {
  SDL_GL_MakeCurrent(_rmluiWindow, _rmluiGlContext);
  glDisable(GL_DEPTH_TEST);
  glClearColor(0.1f, 0.1f, 0.1f, 1.0f);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
  if (_rmluiRenderInterface) _rmluiRenderInterface->BeginFrame();
  for (auto& kv : _rmluiContexts) {
    kv.second->Render();
  }
  if (_rmluiRenderInterface) _rmluiRenderInterface->EndFrame();
  SDL_GL_SwapWindow(_rmluiWindow);
}

extern "C" void RmlUI_Shutdown(void) {
  _rmluiRunning = false;
  _rmluiElements.clear();
  _rmluiCallbacks.clear();
  _rmluiContexts.clear();
  delete _rmluiRenderInterface; _rmluiRenderInterface = nullptr;
  delete _rmluiSystemInterface; _rmluiSystemInterface = nullptr;
  Rml::Shutdown();
  if (_rmluiGlContext) { SDL_GL_DestroyContext(_rmluiGlContext); _rmluiGlContext = nullptr; }
  if (_rmluiWindow) { SDL_DestroyWindow(_rmluiWindow); _rmluiWindow = nullptr; }
  SDL_Quit();
}

extern "C" int32_t RmlUI_IsRunning(void) {
  return _rmluiRunning ? 1 : 0;
}

// ── Query selectors ────────────────────────────────────────────────────────
extern "C" Rml_ElementId Rml_GetElementById(Rml_ContextId ctx, const char* id) {
  if (!id) return 0;
  auto cit = _rmluiContexts.find(ctx);
  if (cit == _rmluiContexts.end()) return 0;
  Rml::Element* el = cit->second->GetElementById(id);
  if (!el) return 0;
  // Check if already in the map
  for (auto& kv : _rmluiElements) {
    if (kv.second == el) return kv.first;
  }
  // Register if not found
  Rml_ElementId eid = _rmluiNextElementId++;
  _rmluiElements[eid] = el;
  return eid;
}

extern "C" Rml_ElementId Rml_QuerySelector(Rml_ElementId el, const char* selector) {
  if (!selector) return 0;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return 0;
  Rml::ElementList results;
  it->second->QuerySelectorAll(results, selector);
  if (results.empty()) return 0;
  Rml_ElementId eid = _rmluiNextElementId++;
  _rmluiElements[eid] = results[0];
  return eid;
}

extern "C" const int32_t* Rml_QuerySelectorAll(Rml_ElementId el, const char* selector) {
  if (!selector) return nullptr;
  auto it = _rmluiElements.find(el);
  if (it == _rmluiElements.end()) return nullptr;
  Rml::ElementList results;
  it->second->QuerySelectorAll(results, selector);
  if (results.empty()) return nullptr; // 0 matches → NULL
  static std::vector<int32_t> ids;
  ids.clear();
  ids.reserve(results.size() + 1);
  for (Rml::Element* r : results) {
    // Check if already in map
    Rml_ElementId rid = 0;
    for (auto& kv : _rmluiElements) {
      if (kv.second == r) { rid = kv.first; break; }
    }
    if (rid == 0) {
      rid = _rmluiNextElementId++;
      _rmluiElements[rid] = r;
    }
    ids.push_back(rid);
  }
  ids.push_back(0); // null-terminated
  return ids.data();
}

extern "C" void Rml_FreeNodeList(const int32_t* elements) {
  // Static buffer managed by Rml_QuerySelectorAll — no-op
  (void)elements;
}

// ── Document body / head ───────────────────────────────────────────────────
// RmlUi 6.2 removed ElementDocument::GetBody()/GetHead(); body/head are
// resolved by traversing the document's direct children for the tag name.
// Do NOT take the first child: a doctype or <head> may precede <body>.

/** Register an element in the ID map, returning its (possibly new) ID. */
static Rml_ElementId _rmluiEnsureId(Rml::Element* el) {
  if (!el) return 0;
  for (auto& kv : _rmluiElements) {
    if (kv.second == el) return kv.first;
  }
  Rml_ElementId eid = _rmluiNextElementId++;
  _rmluiElements[eid] = el;
  return eid;
}

/** Find a direct child of `doc` whose tag name matches `tag`. NULL if absent. */
static Rml::Element* _rmluiFindByTag(Rml::ElementDocument* doc, const char* tag) {
  if (!doc || !tag) return nullptr;
  for (Rml::Element* child = doc->GetFirstChild(); child; child = child->GetNextSibling()) {
    if (child->GetTagName() == tag) return child;
  }
  return nullptr;
}

extern "C" Rml_ElementId Rml_GetBody(Rml_ContextId ctx) {
  auto cit = _rmluiContexts.find(ctx);
  if (cit == _rmluiContexts.end()) return 0;
  if (cit->second->GetDocuments().empty()) return 0;
  Rml::Element* body = _rmluiFindByTag(cit->second->GetDocuments()[0], "body");
  return _rmluiEnsureId(body); // no body → 0
}

extern "C" Rml_ElementId Rml_GetHead(Rml_ContextId ctx) {
  auto cit = _rmluiContexts.find(ctx);
  if (cit == _rmluiContexts.end()) return 0;
  if (cit->second->GetDocuments().empty()) return 0;
  Rml::Element* head = _rmluiFindByTag(cit->second->GetDocuments()[0], "head");
  return _rmluiEnsureId(head); // no head → 0
}

// ── Resource path ──────────────────────────────────────────────────────────
extern "C" int32_t Rml_SetResourcePath(Rml_ContextId ctx, const char* path_list) {
  if (!path_list) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiContexts.find(ctx);
  if (it == _rmluiContexts.end()) return RMLUI_ERR_INVALID_HANDLE;
  // In RmlUI, the file interface is global, not per-context.
  // For v1, we store the path; actual search path integration
  // requires a custom Rml::FileInterface implementation.
  // For now, the RmlUI default file interface handles search paths
  // configured in the RML document's <link> tags.
  (void)path_list;
  return RMLUI_OK;
}

extern "C" int32_t Rml_RegisterResourceProvider(Rml_ContextId ctx, const Rml_ResourceProvider* provider) {
  if (!provider) return RMLUI_ERR_NULL_PARAM;
  auto it = _rmluiContexts.find(ctx);
  if (it == _rmluiContexts.end()) return RMLUI_ERR_INVALID_HANDLE;
  // Custom resource provider registration — v1 placeholder.
  // The provider callbacks would be stored and used during document/font loading.
  (void)ctx; (void)provider;
  return RMLUI_ERR_UNSUPPORTED;
}

