{% include "_preamble.c.njk" %}

{% if rmlui.enabled %}
#include <glad/gl.h>
#include <RmlUi/Core.h>
#include <RmlUi/Debugger.h>
#include <RmlUi_GL3/GL3RenderInterface.h>
#include <RmlUi_SDL/SDL3SystemInterface.h>
{% endif %}

{% if rmlui.enabled %}
  {% include "_rmlui-setup.c.njk" %}
{% endif %}

{% for module in modules -%}
const unsigned char {{ module.varName }}[] = {
{{ module.bufferHex }}
};
const size_t {{ module.lenVar }} = {{ module.bufferLength }};

{% endfor -%}
static int define_exports(Linker &linker, Store::Context ctx, Instance instance, const char* instance_label) {
  static std::unordered_set<std::string> _defined;
{%- for mod in modules %}{% if mod.exports %}
  if (std::strcmp(instance_label, "{{ mod.instanceVar }}") == 0) {
{%- for exp in mod.exports %}
    if (_defined.find("{{ exp.escapedName }}") == _defined.end()) {
      _defined.insert("{{ exp.escapedName }}");
      auto exp = instance.get(ctx, "{{ exp.escapedName }}");
      if (!exp) { std::cerr << "Error obteniendo export {{ exp.safeName }}" << std::endl; return 1; }
      auto result = linker.define(ctx, "env", "{{ exp.escapedName }}", *exp);
      if (!result) { std::cerr << "Error definiendo {{ exp.safeName }}: " << result.err().message() << std::endl; return 1; }
    }
{%- endfor %}
    return 0;
  }{% endif %}{%- endfor %}
  std::cerr << "Unknown instance label " << instance_label << std::endl; return 1;
}

int main(int argc, char *argv[]) {
    Engine engine;
    Store store(engine);
    auto ctx = store.context();
    Linker linker(engine);
    {% if wasi %}
    WasiConfig wasi_config;
    wasi_config.inherit_argv();
    wasi_config.inherit_stdin();
    wasi_config.inherit_stdout();
    wasi_config.inherit_stderr();
    _check_result(ctx.set_wasi(std::move(wasi_config)), "set_wasi");
    _check_result(linker.define_wasi(), "define_wasi");
    {% endif %}{% for func in hostFunctions %}
  {
    auto ty = {{ func.funcTypeCpp }};
    _check_result(linker.define(ctx, "{{ func.escapedModule }}", "{{ func.escapedName }}",
      Func(ctx, ty, [](Caller caller, Span<const Val> args, Span<Val> results) -> Result<std::monostate, Trap> {
{{ func.body }}
      })),
      "define {{ func.escapedModule }}.{{ func.escapedName }}");
  }
{% endfor %}{% if globals.length %}{% for global in globals %}
  _check_result(linker.define(ctx, "{{ global.escapedModule }}", "{{ global.escapedName }}", Global::wrap(ctx, {{ global.cppValue }})), "define {{ global.escapedModule }}.{{ global.escapedName }}");
{%- endfor %}{% endif %}
{% for module in modules %}
  auto {{ module.moduleVar }} = Module::compile(engine, Span<uint8_t>(const_cast<uint8_t*>({{ module.varName }}), {{ module.lenVar }}));
  if (!{{ module.moduleVar }}) { std::cerr << "Error compilando modulo: " << {{ module.moduleVar }}.err().message() << std::endl; return 1; }
{% endfor -%}

{% for module in modules %}
  auto {{ module.instanceVar }} = _check_trap(linker.instantiate(ctx,
      _check_result(std::move({{ module.moduleVar }}), "compile module {{ module.index }}")),
      "instantiate module {{ module.index }}");
  if (define_exports(linker, ctx, {{ module.instanceVar }}, "{{ module.instanceVar }}") != 0) return 1;
{% endfor %}
  auto entry_exp = {{ entryPoint }}.get(ctx, "{{ escapedEntryFunctionName }}");
  if (!entry_exp) { std::cerr << "Entry point {{ escapedEntryFunctionName }} no encontrado" << std::endl; return 1; }
  if (!std::get_if<Func>(&*entry_exp)) { std::cerr << "{{ escapedEntryFunctionName }} no es una funcion" << std::endl; return 1; }
  auto entry_func = std::get<Func>(*entry_exp);

{% if rmlui.enabled %}
  bool running = true;
  while (running) {
    {% include "_rmlui-event-loop.c.njk" %}
    auto result = entry_func.call(ctx, {});
    if (!result) {
      std::cerr << "Error llamando a {{ escapedEntryFunctionName }}" << std::endl;
      running = false;
      break;
    }
    {% include "_rmlui-render.c.njk" %}
  }
  {% include "_rmlui-cleanup.c.njk" %}
{% else %}
  auto result = entry_func.call(ctx, {});
  if (!result) {
    std::cerr << "Error llamando a {{ escapedEntryFunctionName }}" << std::endl;
    return 1;
  }
{% endif %}

  return 0;
}
