# Forzar LF en archivos fuente: los checkouts Windows (autocrlf=true) rompen
# el type stripping de Node (import .ts desde .mjs) y el parsing en CI.
* text=auto
*.ts text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.njk text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.wasm binary
*.ttf binary
*.png binary
*.jpg binary
